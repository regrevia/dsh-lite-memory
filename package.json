{
  "name": "dsh-lite-memory",
  "version": "0.12.0",
  "description": "On-demand memory for the DeepSeek Harness: nothing in the system prompt, one muted line only when something is saved, hit or suggested.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "dsh": ">=0.1.5"
  },
  "scripts": {
    "test": "node test/store.test.mjs && node test/state.test.mjs && node test/view.test.mjs && node test/anchor.test.mjs && node test/recall.test.mjs && node test/evolution-read.test.mjs && node test/learning.test.mjs && node test/scenario.test.mjs && node test/crossing.test.mjs && node test/client.test.mjs && node test/contract.test.mjs",
    "bench": "node bench/bench.mjs",
    "bench:evolution": "node bench/evolution.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "store.js",
    "state.js",
    "view.js",
    "anchor.js",
    "learning.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "TRIGGERS.md",
    "docs",
    "LICENSE",
    "bench",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-lite-memory.git"
  },
  "homepage": "https://github.com/regrevia/dsh-lite-memory#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-lite-memory/issues"
  },
  "author": "regrevia",
  "license": "MIT"
}
